# =============================================================================
# Industrial Communication Simulator - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment
# =============================================================================

# --- General Settings ---
SIMULATOR_NAME=IndustrialCommSimulator
SIMULATOR_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# --- Active Protocol Engines (comma-separated) ---
# Options: modbus, bacnet, mqtt, opcua, siemens, http, sparkplug,
#          dnp3, ethernetip, profinet, canopen, iec61850, iec104,
#          websocket, grpc
ACTIVE_PROTOCOLS=modbus,bacnet,mqtt,opcua,siemens,http,sparkplug

# --- Simulation Physics Engine ---
PHYSICS_UPDATE_INTERVAL=1.0
PHYSICS_ENABLE_NOISE=true
PHYSICS_ENABLE_DRIFT=true
PHYSICS_ENABLE_CROSS_COUPLING=true
PHYSICS_SEED=42

# --- Modbus Configuration ---
MODBUS_ENABLED=true
# Mode: 'tcp' for Modbus TCP (port 502) or 'serial' for Modbus RTU/ASCII
MODBUS_MODE=tcp
MODBUS_TCP_HOST=0.0.0.0
MODBUS_TCP_PORT=5020
# Serial port settings (used when MODBUS_MODE=serial)
# For virtual serial ports: /dev/pts/2 (created by socat or Docker entrypoint)
MODBUS_SERIAL_PORT=/dev/ttyUSB0
MODBUS_SERIAL_BAUD=9600
MODBUS_POLL_INTERVAL=5

# --- BACnet Configuration ---
BACNET_ENABLED=true
BACNET_IP=0.0.0.0
BACNET_PORT=47808
BACNET_MASK=24
BACNET_DEVICE_ID=1001

# --- MQTT Configuration ---
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=industrial-simulator
MQTT_PUBLISH_INTERVAL=5

# --- OPC UA Configuration ---
OPCUA_ENABLED=true
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840
OPCUA_SERVER_NAME=IndustrialSimulator

# --- Siemens S7 (Snap7) Configuration ---
SIEMENS_ENABLED=true
SIEMENS_RACK=0
SIEMENS_SLOT=2
SIEMENS_RACK1=0
SIEMENS_SLOT2=2
SIEMENS_PLC_ADDRESS=127.0.0.1
SIEMENS_TSAP=0x0100

# --- HTTP Simulator Configuration ---
HTTP_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Sparkplug B Configuration ---
SPARKPLUG_ENABLED=true
SPARKPLUG_GROUP_ID=IndustrialSim
SPARKPLUG_EDGE_NODE=simulator-edge-01
SPARKPLUG_DEVICE_ID=sim-device-01
SPARKPLUG_PUBLISH_INTERVAL=5

# --- DNP3 Configuration (SCADA/Utilities) ---
DNP3_ENABLED=false
DNP3_HOST=0.0.0.0
DNP3_PORT=20000
DNP3_OUTSTATION_ADDRESS=100

# --- EtherNet/IP Configuration (Rockwell Automation) ---
ETHERNETIP_ENABLED=false
ETHERNETIP_HOST=0.0.0.0
ETHERNETIP_PORT=44818

# --- PROFINET Configuration (Siemens Industrial Ethernet) ---
PROFINET_ENABLED=false
PROFINET_HOST=0.0.0.0
PROFINET_PORT=34964

# --- CANopen Configuration (Motion Control/Robotics) ---
CANOPEN_ENABLED=false
CANOPEN_NODE_ID=1

# --- IEC 61850 Configuration (Substation Automation) ---
IEC61850_ENABLED=false
IEC61850_HOST=0.0.0.0
IEC61850_PORT=102

# --- IEC 60870-5-104 Configuration (Power Telecontrol) ---
IEC104_ENABLED=false
IEC104_HOST=0.0.0.0
IEC104_PORT=2404
IEC104_ASDU_ADDRESS=1

# --- WebSocket Configuration (Real-time Dashboards) ---
WEBSOCKET_ENABLED=false
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# --- gRPC Configuration (High-performance RPC) ---
GRPC_ENABLED=false
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# --- Device Cluster Configuration ---
# Default device template: name,protocol,type,unit,min,max,noise,drift,initial
# Example: DEFAULT_DEVICES=level:modbus:analog:m:0:100:0.5:0.01:50,temp:bacnet:analog:degC:-20:150:0.3:0.02:25
DEFAULT_DEVICES=